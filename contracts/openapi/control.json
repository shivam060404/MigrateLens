{
  "components": {
    "schemas": {
      "CancelCase": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "expected_version"
        ],
        "title": "CancelCase",
        "type": "object"
      },
      "CreateBinding": {
        "additionalProperties": false,
        "properties": {
          "declared_version": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Declared Version",
            "type": "string"
          },
          "provider_id": {
            "format": "uuid",
            "title": "Provider Id",
            "type": "string"
          },
          "repository_id": {
            "format": "uuid",
            "title": "Repository Id",
            "type": "string"
          }
        },
        "required": [
          "repository_id",
          "provider_id",
          "declared_version"
        ],
        "title": "CreateBinding",
        "type": "object"
      },
      "CreateCase": {
        "additionalProperties": false,
        "properties": {
          "base_sha": {
            "pattern": "^[a-f0-9]{40}$",
            "title": "Base Sha",
            "type": "string"
          },
          "binding_id": {
            "format": "uuid",
            "title": "Binding Id",
            "type": "string"
          },
          "new_contract_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "New Contract Hash",
            "type": "string"
          },
          "old_contract_hash": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Old Contract Hash",
            "type": "string"
          }
        },
        "required": [
          "binding_id",
          "base_sha",
          "old_contract_hash",
          "new_contract_hash"
        ],
        "title": "CreateCase",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "mode": {
            "const": "local-reference",
            "default": "local-reference",
            "title": "Mode",
            "type": "string"
          },
          "service": {
            "const": "migratelens-control",
            "default": "migratelens-control",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "HealthResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "const": "Local reference and pilot acceptance gates are incomplete.",
            "default": "Local reference and pilot acceptance gates are incomplete.",
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "const": "not_ready",
            "default": "not_ready",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "ReadinessResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
